{
  "name": "@kilnflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "test:retry-loop": "tsx src/scripts/test-retry-loop.ts",
    "worker:add": "tsx src/scripts/worker-add.ts",
    "knowledge:ingest": "tsx src/scripts/ingest-knowledge.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@kilnflow/shared-types": "*",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/schedule": "^5.0.1",
    "@prisma/client": "^6.3.1",
    "@types/node-telegram-bot-api": "^0.64.15",
    "node-telegram-bot-api": "^0.67.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.10",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
