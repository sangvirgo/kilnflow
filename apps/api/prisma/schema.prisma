generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Order {
  id          String   @id @default(cuid()) @db.VarChar(30)
  rawText     String   @db.Text
  parsedJson  Json
  confidence  Float?
  assumptions Json?
  createdAt   DateTime @default(now())
  batches     Batch[]
}

model Batch {
  id             String     @id @default(cuid()) @db.VarChar(30)
  batchCode      String     @unique @db.VarChar(20)
  orderId        String     @db.VarChar(30)
  order          Order      @relation(fields: [orderId], references: [id])
  productName    String     @db.VarChar(200)
  currentStage   String     @default("MOLDING") @db.VarChar(30)
  priority       String     @db.VarChar(10)
  glazeType      String?    @db.VarChar(100)
  firingTempC    Int?
  estimatedClayKg Float?
  estimatedFiringHours Float?
  quantity       Int
  deadlineDays   Int?
  defectCount    Int        @default(0)
  kilnId         String?    @db.VarChar(30)
  scheduledStart DateTime?
  /// Phase 9 — uoc luong AI cho 6 cong doan, chot LUC TAO BATCH (khong tinh lai khi xem)
  stageEstimates Json?
  claimedByUserId String?   @db.VarChar(30)
  claimedByName   String?   @db.VarChar(100)
  lastStageChangeAt DateTime @default(now())
  createdAt      DateTime   @default(now())
  logs           StageLog[]
  alerts         Alert[]
}

model StageLog {
  id        String   @id @default(cuid()) @db.VarChar(30)
  batchId   String   @db.VarChar(30)
  batch     Batch    @relation(fields: [batchId], references: [id])
  stage     String   @db.VarChar(30)
  enteredAt DateTime @default(now())
  note      String?  @db.Text
}

model Alert {
  id        String   @id @default(cuid()) @db.VarChar(30)
  batchId   String   @db.VarChar(30)
  batch     Batch    @relation(fields: [batchId], references: [id])
  level     String   @db.VarChar(20)
  message   String   @db.Text
  source    String   @db.VarChar(100)
  createdAt DateTime @default(now())
}

model Kiln {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @db.VarChar(200)
  capacity  Int      @default(1)
}

model HistoricalBatch {
  id             String   @id @default(cuid()) @db.VarChar(30)
  productName    String   @db.VarChar(200)
  pattern        String?  @db.VarChar(200)
  heightCm       Float?
  glazeType      String?  @db.VarChar(100)
  actualClayKg   Float
  actualFiringHours Float
  /// Phase 9 — breakdown thoi gian tung cong doan: { MOLDING: 6.2, DRYING_TRIMMING: 30, ... }
  stageDurationsHours Json?
  embedding      Bytes    @db.LongBlob
  embeddingModel String   @default("local-hash-bow-256") @db.VarChar(50)
  createdAt      DateTime @default(now())
}

model KnowledgeDoc {
  id        String   @id @default(cuid()) @db.VarChar(30)
  title     String   @db.VarChar(500)
  sourceUrl String?  @db.VarChar(2000)
  chunks    KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String   @id @default(cuid()) @db.VarChar(30)
  docId      String   @db.VarChar(30)
  doc        KnowledgeDoc @relation(fields: [docId], references: [id])
  content    String   @db.Text
  embedding  Bytes    @db.LongBlob
  embeddingModel String @default("local-hash-bow-256") @db.VarChar(50)
  chunkIndex Int
}

/// Phase 8.3.4 — state "đang chờ mô tả lỗi" của luồng /baocao, persist qua restart (KHÔNG dùng biến in-memory).
model PendingReport {
  id        String   @id @default(cuid()) @db.VarChar(30)
  chatId    String   @db.VarChar(30)
  userId    String   @db.VarChar(30)
  username  String?  @db.VarChar(100)
  batchId   String   @db.VarChar(30)
  severity  String   @db.VarChar(20)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([chatId, userId])
}

/// Phase 8.6.1 — thợ được cấp phép DM riêng với bot; assignedStage = công đoạn đang phụ trách.
model AuthorizedWorker {
  id             String    @id @default(cuid()) @db.VarChar(30)
  telegramUserId String    @unique @db.VarChar(30)
  displayName    String    @db.VarChar(100)
  assignedStage  String?   @db.VarChar(30)
  menuReady      Boolean   @default(false)
  createdAt      DateTime  @default(now())
}