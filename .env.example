# ==== Database ====
DATABASE_URL="file:./dev.db"

# ==== LLM (dat mot trong hai key -> tu dong chuyen sang provider that) ====
# GEMINI_API_KEY=your_gemini_key
# DEEPSEEK_API_KEY=your_deepseek_key
# LLM_PROVIDER=auto   # auto | gemini | deepseek | mock
# LLM_MODEL=          # override model mac dinh theo provider

# ==== Embeddings ====
# EMBEDDING_PROVIDER=auto   # auto | gemini | local (seed va query phai cung provider)

# ==== Telegram (thieu token -> he thong van chay, chi log warn thay vi gui) ====
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890

# ==== API ====
PORT=3001
WEB_ORIGIN=http://localhost:3000
MONITOR_INTERVAL_MS=300000
MONITOR_ENABLED=true