# ==== Database (MySQL) ====
DATABASE_URL="mysql://root:password@mysql:3306/kilnflow"

# ==== LLM (Gemini only) ====
# GEMINI_API_KEY=your_gemini_key_here
# LLM_PROVIDER=auto   # auto | gemini | mock

# ==== Embeddings ====
# EMBEDDING_PROVIDER=auto   # auto | gemini | local

# ==== Telegram (optional) ====
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ==== API ====
PORT=3001
WEB_ORIGIN=http://localhost:3000
MONITOR_INTERVAL_MS=300000
MONITOR_ENABLED=true

# ==== Docker MySQL ====
MYSQL_ROOT_PASSWORD=password